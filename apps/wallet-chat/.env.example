# Testnet is the only default. Mainnet activation requires the completed,
# independently verified contracts deployment manifest and an explicit enable value.
ACKRATE_WALLET_NETWORK=testnet
ACKRATE_ENABLE_MAINNET=
ACKRATE_MAINNET_DEPLOYMENT_MANIFEST_JSON=

# Public identities used by the on-chain mandate. Never put a secret key here.
ACKRATE_CHAT_AGENT_PUBLIC_KEY=
ACKRATE_CHAT_MERCHANT_PUBLIC_KEY=
ACKRATE_CHAT_MERCHANT_NAME=Research Source
ACKRATE_CHAT_MERCHANT_URL=
# Optional JSON array of {id,title,description,path,price}. Paths must be
# origin-relative and every model purchase is restricted to this allowlist.
ACKRATE_CHAT_CATALOG_JSON=

# Server-only autonomous agent signer. This account can act only inside a
# registered mandate; it still must never appear in browser data or logs.
ACKRATE_CHAT_AGENT_SECRET=

# Wallet-authenticated application sessions.
ACKRATE_SESSION_SECRET=

# Durable one-time auth, payment idempotency, and settlement recovery state.
# Required before mainnet activation.
DATABASE_URL=

# AI SDK provider configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Visible release fingerprint. In hosted environments this should match the
# immutable source revision being deployed.
ACKRATE_APP_SOURCE_COMMIT=
# Exact hosted origin used for same-origin enforcement. Required on mainnet.
ACKRATE_APP_ORIGIN=
