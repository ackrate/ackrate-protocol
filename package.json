{
  "name": "ackrate-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-driven payments: AP2 mandates enforced on-chain by Soroban via x402.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackrate/ackrate-protocol.git"
  },
  "homepage": "https://github.com/ackrate/ackrate-protocol#readme",
  "bugs": {
    "url": "https://github.com/ackrate/ackrate-protocol/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ackrate/wallet-chat",
    "build": "npm run build -w @ackrate/stellar && npm run build -w @ackrate/core && npm run build --workspaces --if-present",
    "cli:bundle": "esbuild packages/cli/src/index.ts --bundle --platform=node --format=esm --target=node20 --external:@stellar/stellar-sdk --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outfile=packages/cli/dist/ackrate-cli.bundle.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc",
    "check:branding": "node scripts/check-branding.mjs",
    "verify": "node scripts/verify.mjs",
    "demo": "node scripts/e2e-testnet.mjs",
    "keys:derive-freighter": "node scripts/derive-freighter.mjs",
    "deploy:testnet": "node scripts/deploy.mjs",
    "e2e:testnet": "node scripts/e2e-testnet.mjs",
    "e2e:composites": "node scripts/e2e-composites.mjs",
    "e2e:sdk": "node scripts/e2e-sdk.mjs",
    "e2e:x402": "npm run agents:testnet",
    "agents:testnet": "npm run build && tsx scripts/e2e-x402.ts",
    "drills:testnet": "npm run build && tsx scripts/failure-drills-testnet.ts",
    "adversarial:testnet": "npm run build && node scripts/adversarial/run-all.mjs",
    "gatecheck": "node scripts/gatecheck-mandate.mjs",
    "gatecheck:release": "node scripts/gatecheck-release.mjs"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "playwright": "^1.60.0",
    "stellar-hd-wallet": "^0.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ackrate/core": "^0.3.3"
  },
  "overrides": {
    "axios": "1.19.0",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
