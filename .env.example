# Copy to .env (git-ignored). Hot testnet only — never reuse on mainnet, never commit real values.

# Network
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Burner account. Set the PUBLIC key; `npm run keys:derive-freighter` scans
# BIP39 indexes for the match. The seed phrase is typed at runtime, never stored.
ACKRATE_BURNER_PUBLIC_KEY=G...your-burner-address...
ACKRATE_BURNER_SECRET_KEY=S...your-burner-secret...

# Deployment. The addresses the SDK and apps actually use are the single source of
# truth in packages/stellar/src/deployments.ts. These vars just mirror the deployed
# IDs for local tooling; `npm run deploy:testnet` updates only .env.
# Set this to an external contracts checkout for legacy Testnet deployment:
# ACKRATE_CONTRACTS_ROOT=/absolute/path/to/ackrate-protocol-contracts
MANDATE_REGISTRY_CONTRACT_ID=
USDC_SAC_CONTRACT_ID=
