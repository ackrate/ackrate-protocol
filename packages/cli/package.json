{
  "name": "@ackrate/cli",
  "version": "0.1.10",
  "description": "Command-line tool for the Ackrate MandateRegistry: scaffold a project, fund testnet accounts, create AP2 mandates, and pay on-chain. The contract is the source of truth.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackrate/ackrate-protocol.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ackrate/ackrate-protocol/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ackrate/ackrate-protocol/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "ackrate",
    "agent-payments",
    "x402",
    "ap2",
    "mandate",
    "cli"
  ],
  "type": "module",
  "bin": {
    "ackrate": "dist/ackrate-cli.bundle.mjs"
  },
  "files": [
    "dist/ackrate-cli.bundle.mjs",
    "README.md",
    "examples/mainnet-authority-manifest.template.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/version.test.ts src/config.test.ts src/settlement-store.test.ts src/payment-failure.test.ts src/ops-signing-request.test.ts src/mainnet-demo.test.ts",
    "start": "tsx src/index.ts",
    "prepack": "npm --prefix ../.. run cli:bundle"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0"
  },
  "devDependencies": {
    "@ackrate/core": "*",
    "@ackrate/stellar": "*",
    "commander": "^12.1.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
